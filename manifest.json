{
  "manifest_version": 3,
  "name": "OmniDownload",
  "version": "1.1.0",
  "description": "OmniDownload \u2014 save images and videos from Instagram, Reddit, YouTube, X, and more.",
  "permissions": [
    "downloads",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*",
    "https://*.youtube.com/*",
    "https://*.googlevideo.com/*",
    "https://x.com/*",
    "https://api.x.com/*",
    "https://cdn.syndication.twimg.com/*",
    "https://*.twimg.com/*",
    "https://api.imgur.com/*",
    "https://*.imgur.com/*",
    "https://*.redd.it/*",
    "https://*.reddit.com/*",
    "https://*.instagram.com/*",
    "https://*.cdninstagram.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dist/content.bundle.js"
      ],
      "css": [
        "styles/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "OmniDownload \u2014 save media on this page",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
